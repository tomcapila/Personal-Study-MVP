{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cursos.schema.json",
  "title": "Lista de cursos",
  "type": "object",
  "required": ["cursos"],
  "additionalProperties": false,
  "properties": {
    "cursos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nome", "descricao", "avisos", "semestres", "carreira_disponivel"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "defs.schema.json#/$defs/curso_id" },
          "nome": { "type": "string" },
          "descricao": { "type": "string" },
          "avisos": { "type": "array", "items": { "type": "string" } },
          "carreira_disponivel": { "type": "boolean" },
          "semestres": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["semestre", "disciplinas"],
              "additionalProperties": false,
              "properties": {
                "semestre": { "type": "integer", "minimum": 1, "maximum": 12 },
                "disciplinas": { "type": "array", "items": { "$ref": "defs.schema.json#/$defs/slug" } }
              }
            }
          }
        }
      }
    }
  }
}
